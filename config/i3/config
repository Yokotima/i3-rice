# i3 config — Catppuccin Mocha rice
# Basé sur les dotfiles de Brozi (r/unixporn "Who said i3 can't be pretty"), nettoyé et rendu portable.
# Doc : https://i3wm.org/docs/userguide.html

### --- Variables --- ###
set $mod Mod4
set $alt Mod1
set $term kitty
set $browser firefox
set $scrtch_display scratchpad show; move position center;

### --- Autostart --- ###
# environnement dbus (portails, notifications, polkit)
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP

# agent polkit (le chemin change selon la distro)
exec --no-startup-id bash -c 'for p in /usr/lib/policykit-1-gnome /usr/lib/polkit-gnome /usr/libexec /usr/lib/polkit-gnome-1; do [ -x "$p/polkit-gnome-authentication-agent-1" ] && exec "$p/polkit-gnome-authentication-agent-1"; done'

# ui scaling / dpi
exec_always --no-startup-id xrdb -merge ~/.Xresources

# fond d'écran
exec_always --no-startup-id ~/.config/wallpapers/script/wallpaper.sh --restore

# compositeur (flou, ombres, animations — picom >= 12 requis)
exec_always --no-startup-id bash -c 'pkill -x picom; sleep 0.3; exec picom -b'

# barre
exec_always --no-startup-id ~/.config/polybar/launch.sh

# notifications
exec_always --no-startup-id bash -c 'pkill -x dunst; exec dunst'

# verrouillage : écran de veille après 15 min, verrou avant la mise en veille système
exec_always --no-startup-id xset s 900 10
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/scripts/lock.sh

# tiling automatique (spirale), nécessite i3-autolayout
exec_always --no-startup-id ~/.config/i3/scripts/autolayout.sh

# applet réseau (optionnel, ne plante pas si absent)
exec --no-startup-id bash -c 'command -v nm-applet >/dev/null && nm-applet'

### --- Workspaces --- ###
set $ws1 "1: Terminals"
set $ws2 "2: Browsers"
set $ws3 "3: Coding"
set $ws4 "4: Communication"
set $ws5 "5: Tasks"
set $ws6 "6: Context"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $ws11 "11"
set $ws12 "12"

workspace_auto_back_and_forth yes
focus_wrapping no

### --- Touches multimédia --- ###
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/scripts/volume.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/scripts/volume.sh down
bindsym XF86AudioMute        exec --no-startup-id ~/.config/i3/scripts/volume.sh mute
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

### --- Raccourcis --- ###
floating_modifier $mod
tiling_drag modifier titlebar

bindsym $mod+Return exec $term
bindsym $mod+b exec $browser
bindsym $mod+q kill

# rofi
bindsym $mod+space exec --no-startup-id ~/.config/rofi/scripts/launcher-t1-run
bindsym $mod+p     exec --no-startup-id ~/.config/rofi/scripts/powermenu_t1
bindsym Print      exec --no-startup-id ~/.config/rofi/scripts/screenshot
bindsym $mod+$alt+v exec --no-startup-id ~/.config/rofi/scripts/volume

# lock
bindsym $mod+Shift+x exec --no-startup-id ~/.config/i3/scripts/lock.sh

# focus / déplacement
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# splits / layouts
bindsym $mod+x split h
bindsym $mod+z split v
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+Shift+s exec --no-startup-id i3-autolayout stackmode --file-layout /tmp/i3-autolayout-stacked.save
bindsym $mod+Shift+t exec --no-startup-id i3-autolayout tabmode   --file-layout /tmp/i3-autolayout-tabbed.save
bindsym $mod+Shift+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+$alt+space focus mode_toggle
bindsym $mod+a focus parent

# config
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# workspaces (1-12)
include ~/.config/i3/workspace-binds.conf

# mode resize
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left  resize shrink width 10 px or 10 ppt
    bindsym Down  resize grow height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

### --- Règles de fenêtres --- ###
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="(?i)pavucontrol|nm-connection-editor|Lxappearance"] floating enable
for_window [class="nmtui-float"] floating enable, resize set 60 ppt 60 ppt, move position center

# quelques assignations (à adapter)
assign [class="(?i)^firefox$"] $ws2
assign [class="(?i)^discord$"] $ws4

### --- Scratchpad terminal ($mod+grave) --- ###
for_window [class="^1-scrtch$"] floating enable, move scratchpad, resize set 80 ppt 75 ppt
exec_always --no-startup-id pgrep -f '^kitty --class 1-scrtch' || kitty --class '1-scrtch'
bindsym $mod+grave [class="^1-scrtch$"] $scrtch_display

### --- Apparence --- ###
include ~/.config/i3/theme.conf

font pango:JetBrainsMono Nerd Font 14px

gaps inner 10
gaps outer 5

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
bindsym $mod+w exec --no-startup-id ~/.config/wallpapers/script/wallpaper.sh
for_window [class="wallpaper-carousel"] floating enable, border none, move position center
bindsym $mod+n exec --no-startup-id ~/.config/rofi/bin/wifi-menu.sh
